{
  "name": "myplace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @myplace/web",
    "dev:api": "npm run dev --workspace @myplace/api",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @myplace/web",
    "test": "npm run test:web",
    "test:web": "npm run test --workspace @myplace/web",
    "start:api": "npm run start --workspace @myplace/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
